{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "nextjs",
    "jsx-a11y",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": { "browser": true, "node": true, "es2024": true },
  "ignorePatterns": [".agents/**", "lib/opentide/generated/**"],
  "rules": {
    "eslint/no-unused-vars": "error",
    "typescript/no-explicit-any": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    // The automatic JSX runtime (tsconfig "jsx": "react-jsx") needs no React import.
    "react/react-in-jsx-scope": "off",
    // Effects list layout and retry triggers on purpose (`attempt`, `empty`, the columns).
    "react/exhaustive-effect-dependencies": "off",
    // Index keys mark positions in static lists: lines of code, `::` parts, references.
    "react/no-array-index-key": "off",
    // Same calls as doctor.config.ts: the autocomplete listbox, the resize separator and
    // the segmented controls use ARIA roles on purpose.
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    // `sigma` and `graphology` document their default exports.
    "import/no-named-as-default": "off",
    // CSS and next-env.d.ts imports are side effects by design.
    "import/no-unassigned-import": "off",
    // `__dirname` from `import.meta.url` in the Node scripts.
    "eslint/no-underscore-dangle": "off",
    // Every sorted array here is a fresh copy, and the target is ES2022.
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off",
    // Worker and MessagePort postMessage take no targetOrigin.
    "unicorn/require-post-message-target-origin": "off",
    // The layout worker is single use: one `onmessage` handler, then terminate.
    "unicorn/prefer-add-event-listener": "off"
  },
  "overrides": [
    {
      // Sigma is an imperative WebGL instance driven from effects and refs (see doctor.config.ts).
      "files": ["components/explorer/graph/**"],
      "rules": {
        "react/refs": "off",
        "react/set-state-in-effect": "off"
      }
    }
  ]
}
