{
  "name": "@opentide/explorer",
  "version": "0.1.0",
  "description": "Interactive OpenTide corpus explorer — static Next.js UI",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "opentide-explorer-build": "./bin/build.mjs"
  },
  "files": [
    "bin",
    "app",
    "components",
    "lib",
    "public",
    "scripts",
    "next.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "doctor.config.ts"
  ],
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/generate-mock-bundle.mjs && next build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "doctor": "react-doctor .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "dependencies": {
    "@orama/orama": "^3.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@xyflow/react": "^12.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "effect": "^3.14.16",
    "lucide-react": "^0.487.0",
    "next": "^15.2.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "^3.2.1",
    "tailwind-merge": "^3.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.3",
    "@types/dagre": "^0.7.52",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "oxfmt": "^0.9.0",
    "oxlint": "^0.16.4",
    "react-doctor": "^0.5.8",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
