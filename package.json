{
  "name": "@opentide/explorer",
  "version": "0.1.0",
  "description": "Interactive opentide corpus explorer — static Next.js UI",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "opentide-explorer-build": "./bin/build.mjs"
  },
  "files": [
    "bin",
    "app",
    "components",
    "lib",
    "public",
    "scripts",
    "next.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "doctor.config.ts"
  ],
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm codegen:specs && node scripts/generate-mock-bundle.mjs && next build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "doctor": "react-doctor .",
    "test": "node scripts/generate-mock-bundle.mjs && vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test && pnpm codegen:check",
    "codegen:specs": "node scripts/codegen-from-specs.mjs",
    "codegen:check": "node scripts/codegen-from-specs.mjs --check",
    "validate": "pnpm codegen:specs && pnpm check && pnpm build",
    "prepublishOnly": "pnpm validate"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sigma/edge-curve": "^3.1.0",
    "@sigma/node-image": "^3.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "sigma": "^3.0.3",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "json-schema-to-typescript": "^16.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "react-doctor": "^0.9.18",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "brace-expansion": ">=5.0.9",
      "browserslist": ">=4.28.7",
      "fast-uri": ">=4.1.3",
      "js-yaml": ">=5.4.1 <6",
      "nanoid": ">=3.3.18 <4",
      "sharp": ">=0.35.5",
      "source-map-js": ">=1.2.2"
    }
  }
}
