{
  "name": "@opentide/explorer",
  "version": "0.1.0",
  "description": "Interactive OpenTide corpus explorer — static Next.js UI",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "opentide-explorer-build": "./bin/build.mjs"
  },
  "files": [
    "bin",
    "app",
    "components",
    "lib",
    "public",
    "scripts",
    "next.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "doctor.config.ts"
  ],
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm codegen:specs && node scripts/generate-mock-bundle.mjs && next build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "doctor": "react-doctor .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test && pnpm codegen:check",
    "codegen:specs": "node scripts/codegen-from-specs.mjs",
    "codegen:check": "node scripts/codegen-from-specs.mjs --check",
    "validate": "pnpm codegen:specs && pnpm check && pnpm build",
    "prepublishOnly": "pnpm validate"
  },
  "dependencies": {
    "@orama/orama": "^3.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-sigma/core": "^5.0.6",
    "@sigma/edge-curve": "^3.1.0",
    "@sigma/node-image": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "^3.14.16",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lucide-react": "^0.487.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "shiki": "^3.2.1",
    "sigma": "^3.0.3",
    "tailwind-merge": "^3.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "json-schema-to-typescript": "^15.0.4",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "react-doctor": "^0.9.1",
    "smol-toml": "^1.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
