{
  "name": "@opentide/explorer",
  "version": "0.1.0",
  "description": "Interactive OpenTide corpus explorer — static Next.js UI",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "opentide-explorer-build": "./bin/build.mjs"
  },
  "files": [
    "bin",
    "app",
    "components",
    "lib",
    "public",
    "scripts",
    "next.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "doctor.config.ts"
  ],
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm codegen:specs && node scripts/generate-mock-bundle.mjs && next build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "doctor": "react-doctor .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test && pnpm codegen:check",
    "codegen:specs": "node scripts/codegen-from-specs.mjs",
    "codegen:check": "node scripts/codegen-from-specs.mjs --check",
    "validate": "pnpm codegen:specs && pnpm check && pnpm build",
    "prepublishOnly": "pnpm validate"
  },
  "dependencies": {
    "@orama/orama": "^3.1.3",
    "@radix-ui/react-dialog": "^1.1.21",
    "@radix-ui/react-scroll-area": "^1.2.16",
    "@radix-ui/react-slot": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.14",
    "@react-sigma/core": "^5.0.6",
    "@sigma/edge-curve": "^3.1.0",
    "@sigma/node-image": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "^3.22.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lucide-react": "^1.26.0",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "shiki": "^4.3.1",
    "sigma": "^3.0.3",
    "tailwind-merge": "^3.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "json-schema-to-typescript": "^15.0.4",
    "oxfmt": "^0.9.0",
    "oxlint": "^0.16.4",
    "react-doctor": "^0.5.8",
    "smol-toml": "^1.7.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "brace-expansion": ">=5.0.8",
      "fast-uri": ">=3.1.4",
      "js-yaml": ">=4.3.0",
      "sharp": ">=0.35.0"
    }
  }
}
